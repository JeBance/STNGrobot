[Unit]
Description=STNGrobot Telegram Bot
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/git/STNGrobot
Environment="PATH=/root/git/STNGrobot/venv/bin"
ExecStart=/root/git/STNGrobot/venv/bin/python -m bot.main
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
